{
  "openapi": "3.0.0",
  "paths": {
    "/api/auth/sign-in": {
      "post": {
        "operationId": "AuthController_signIn",
        "parameters": [
          {
            "name": "x-application",
            "in": "header",
            "required": false,
            "schema": { "type": "string", "example": "web", "enum": ["web", "mobile"] }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/SignInDto" } }
          }
        },
        "responses": {
          "200": {
            "description": "sign-in",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/SignInResponse" } }
            }
          }
        },
        "summary": "Войти",
        "tags": ["🔒 auth"]
      }
    },
    "/api/auth/sign-out": {
      "post": {
        "operationId": "AuthController_signOut",
        "parameters": [
          {
            "name": "x-application",
            "in": "header",
            "required": false,
            "schema": { "type": "string", "example": "web", "enum": ["web", "mobile"] }
          }
        ],
        "responses": {
          "200": {
            "description": "sign-out",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/BaseResponse" } }
            }
          }
        },
        "security": [{ "mobile-auth": [] }, { "web-auth": [] }],
        "summary": "Выйти",
        "tags": ["🔒 auth"]
      }
    },
    "/api/users/profile": {
      "patch": {
        "operationId": "UsersController_updateProfile",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/UpdateProfileDto" } }
          }
        },
        "responses": {
          "200": {
            "description": "update profile",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UpdateProfileResponse" }
              }
            }
          }
        },
        "security": [{ "mobile-auth": [] }, { "web-auth": [] }],
        "summary": "Обновить профиль пользователя",
        "tags": ["💂‍♂️ users"]
      },
      "get": {
        "operationId": "UsersController_getProfile",
        "parameters": [],
        "responses": {
          "200": {
            "description": "get profile",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GetProfileResponse" }
              }
            }
          }
        },
        "security": [{ "mobile-auth": [] }, { "web-auth": [] }],
        "summary": "Получить профиль пользователя",
        "tags": ["💂‍♂️ users"]
      }
    },
    "/api/otps/otp": {
      "post": {
        "operationId": "OtpsController_createOtp",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/CreateOtpDto" } }
          }
        },
        "responses": {
          "200": {
            "description": "create otp",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/CreateOtpResponse" } }
            }
          }
        },
        "summary": "Создание отп кода",
        "tags": ["🔑 otps"]
      }
    },
    "/api/transactions/{id}": {
      "get": {
        "operationId": "TransactionsController_getTransaction",
        "parameters": [
          { "name": "id", "required": true, "in": "path", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Получить транзакцию по ID",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GetTransactionResponse" }
              }
            }
          }
        },
        "summary": "Получить транзакцию по ID",
        "tags": ["💸 transactions"]
      }
    },
    "/api/transactions/pay": {
      "post": {
        "operationId": "TransactionsController_payTransaction",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/PayTransactionDto" } }
          }
        },
        "responses": {
          "200": {
            "description": "Оплата транзакции: новая карта / сохранённая карта",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PayTransactionResponse" }
              }
            }
          }
        },
        "summary": "Оплатить (закрыть) транзакцию картой",
        "tags": ["💸 transactions"]
      }
    },
    "/api/transactions/{id}/pay/qr": {
      "post": {
        "operationId": "TransactionsController_payTransactionByQr",
        "parameters": [
          { "name": "id", "required": true, "in": "path", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Оплата транзакции по QR",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PayTransactionResponse" }
              }
            }
          }
        },
        "summary": "Оплатить транзакцию по QR",
        "tags": ["💸 transactions"]
      }
    },
    "/api/pizzas/catalog": {
      "get": {
        "operationId": "PizzasController_getPizzaCatalog",
        "parameters": [
          {
            "name": "category",
            "required": false,
            "in": "query",
            "description": "Фильтр по категории",
            "schema": { "$ref": "#/components/schemas/PizzaCategory" }
          }
        ],
        "responses": {
          "200": {
            "description": "catalog",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GetPizzaCatalogResponse" }
              }
            }
          }
        },
        "summary": "Получить каталог",
        "tags": ["🍕 pizzas"]
      }
    },
    "/api/pizzas/calculate": {
      "post": {
        "operationId": "PizzasController_calculatePizzaOrder",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CalculatePizzaOrderDto" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "calculate",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CalculateOrderResponse" }
              }
            }
          }
        },
        "summary": "Рассчитать стоимость корзины и комиссию",
        "tags": ["🍕 pizzas"]
      }
    },
    "/api/pizzas/payment": {
      "post": {
        "operationId": "PizzasController_createPizzaPayment",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreatePizzaPaymentDto" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "payment",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CreatePizzaPaymentResponse" }
              }
            }
          }
        },
        "summary": "Создать заказ и транзакцию для оплаты",
        "tags": ["🍕 pizzas"]
      }
    },
    "/api/pizzas/orders": {
      "get": {
        "operationId": "PizzasController_getPizzaOrders",
        "parameters": [],
        "responses": {
          "200": {
            "description": "orders",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GetPizzaOrdersResponse" }
              }
            }
          }
        },
        "security": [{ "mobile-auth": [] }, { "web-auth": [] }],
        "summary": "Получить все заказы",
        "tags": ["🍕 pizzas"]
      }
    },
    "/api/pizzas/orders/paid": {
      "get": {
        "operationId": "PizzasController_getPizzaPaidOrder",
        "parameters": [
          {
            "name": "token",
            "required": true,
            "in": "query",
            "description": "Одноразовый токен доступа",
            "schema": {
              "example": "1f2e3d4c5b6a7980abcdef1234567890abcdef1234567890abcdef1234567890",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "order",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GetPizzaOrderResponse" }
              }
            }
          }
        },
        "summary": "Получить оплаченный заказ по одноразовому токену",
        "tags": ["🍕 pizzas"]
      }
    },
    "/api/pizzas/orders/{orderId}": {
      "get": {
        "operationId": "PizzasController_getPizzaOrder",
        "parameters": [
          {
            "name": "orderId",
            "required": true,
            "in": "path",
            "description": "Идентификатор заказа",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "order",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GetPizzaOrderResponse" }
              }
            }
          }
        },
        "security": [{ "mobile-auth": [] }, { "web-auth": [] }],
        "summary": "Получить заказ",
        "tags": ["🍕 pizzas"]
      }
    },
    "/api/pizzas/orders/{orderId}/cancel": {
      "patch": {
        "operationId": "PizzasController_cancelPizzaOrder",
        "parameters": [
          {
            "name": "orderId",
            "required": true,
            "in": "path",
            "description": "Идентификатор заказа",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "order cancel",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CancelPizzaOrderResponse" }
              }
            }
          }
        },
        "security": [{ "mobile-auth": [] }, { "web-auth": [] }],
        "summary": "Отменить заказ",
        "tags": ["🍕 pizzas"]
      }
    }
  },
  "info": {
    "title": "juniors bootcamp backend 🔥",
    "description": "Апи для выполнения индивидуальных заданий",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "mobile-auth": {
        "scheme": "bearer",
        "bearerFormat": "Session  token",
        "type": "http",
        "description": "Для x-application: mobile"
      },
      "web-auth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session_token",
        "description": "Для x-application: web"
      }
    },
    "schemas": {
      "SignInDto": {
        "type": "object",
        "properties": {
          "phone": { "type": "string", "description": "Номер телефона", "example": "89990009999" },
          "code": { "type": "number", "description": "Отп код" }
        },
        "required": ["phone", "code"]
      },
      "User": {
        "type": "object",
        "properties": {
          "_id": { "type": "string", "description": "ID пользователя" },
          "phone": { "type": "string", "description": "Номер телефона", "example": "89990009999" },
          "firstname": { "type": "string", "description": "Имя", "example": "Иван" },
          "middlename": { "type": "string", "description": "Отчество", "example": "Иванович" },
          "lastname": { "type": "string", "description": "Фамилия", "example": "Иванов" },
          "email": {
            "type": "string",
            "description": "Почта",
            "example": "example.email@gmail.com"
          },
          "city": { "type": "string", "description": "Город", "example": "Москва" }
        },
        "required": ["_id", "phone"]
      },
      "SignInResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "description": "Статус запроса" },
          "reason": { "type": "string", "description": "Причина ошибки" },
          "token": { "type": "string", "description": "Токен сессии" },
          "user": {
            "description": "Пользователь",
            "allOf": [{ "$ref": "#/components/schemas/User" }]
          }
        },
        "required": ["success", "token", "user"]
      },
      "BaseResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "description": "Статус запроса" },
          "reason": { "type": "string", "description": "Причина ошибки" }
        },
        "required": ["success"]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "firstname": { "type": "string", "description": "Имя", "example": "Иван" },
          "middlename": { "type": "string", "description": "Отчество", "example": "Иванович" },
          "lastname": { "type": "string", "description": "Фамилия", "example": "Иванов" },
          "email": {
            "type": "string",
            "description": "Почта",
            "example": "example.email@gmail.com"
          },
          "city": { "type": "string", "description": "Город", "example": "Москва" }
        }
      },
      "UpdateProfileResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "description": "Статус запроса" },
          "reason": { "type": "string", "description": "Причина ошибки" },
          "user": {
            "description": "Пользователь",
            "allOf": [{ "$ref": "#/components/schemas/User" }]
          }
        },
        "required": ["success", "user"]
      },
      "GetProfileResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "description": "Статус запроса" },
          "reason": { "type": "string", "description": "Причина ошибки" },
          "user": {
            "description": "Пользователь",
            "allOf": [{ "$ref": "#/components/schemas/User" }]
          }
        },
        "required": ["success", "user"]
      },
      "CreateOtpDto": {
        "type": "object",
        "properties": {
          "phone": { "type": "string", "description": "Номер телефона", "example": "89990009999" }
        },
        "required": ["phone"]
      },
      "CreateOtpResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "description": "Статус запроса" },
          "reason": { "type": "string", "description": "Причина ошибки" },
          "retryDelay": {
            "type": "number",
            "description": "Время запроса повторного отп кода в мс",
            "example": 120000
          }
        },
        "required": ["success", "retryDelay"]
      },
      "TransactionOrderType": {
        "type": "string",
        "enum": ["car", "delivery", "pizza", "cinema", "game"],
        "description": "Тип заказа, связанного с транзакцией"
      },
      "TransactionStatus": { "type": "string", "enum": ["pending", "paid", "failed"] },
      "Transaction": {
        "type": "object",
        "properties": {
          "_id": { "type": "string", "description": "ID транзакции" },
          "phone": {
            "type": "string",
            "description": "Телефон владельца транзакции",
            "example": "89990009999"
          },
          "orderId": {
            "type": "string",
            "description": "ID заказа, связанного с транзакцией",
            "nullable": true
          },
          "orderType": {
            "description": "Тип заказа, связанного с транзакцией",
            "allOf": [{ "$ref": "#/components/schemas/TransactionOrderType" }]
          },
          "amount": { "type": "number", "description": "Сумма транзакции", "example": 1290 },
          "currency": { "type": "string", "description": "Валюта транзакции", "example": "RUB" },
          "status": { "allOf": [{ "$ref": "#/components/schemas/TransactionStatus" }] },
          "expiresAt": {
            "format": "date-time",
            "type": "string",
            "description": "Время истечения транзакции (createdAt + 10 мин)"
          },
          "createdAt": { "format": "date-time", "type": "string", "description": "Дата создания" },
          "cardCryptoPacket": {
            "type": "string",
            "description": "Крипто-пакет карты в base64-формате",
            "nullable": true
          },
          "paidAt": {
            "format": "date-time",
            "type": "string",
            "description": "Дата оплаты",
            "nullable": true
          },
          "accessToken": {
            "type": "string",
            "description": "Токен доступа к транзакции",
            "nullable": true
          }
        },
        "required": ["_id", "phone", "orderType", "amount", "currency", "status", "expiresAt"]
      },
      "GetTransactionResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "description": "Статус запроса" },
          "reason": { "type": "string", "description": "Причина ошибки" },
          "transaction": {
            "description": "Транзакция",
            "allOf": [{ "$ref": "#/components/schemas/Transaction" }]
          }
        },
        "required": ["success", "transaction"]
      },
      "TransactionPayMethod": {
        "type": "string",
        "enum": ["new_card", "saved_card", "qr"],
        "description": "Способ оплаты"
      },
      "PayTransactionDto": {
        "type": "object",
        "properties": {
          "transactionId": { "type": "string", "description": "ID транзакции" },
          "method": {
            "description": "Способ оплаты",
            "example": "new_card",
            "allOf": [{ "$ref": "#/components/schemas/TransactionPayMethod" }]
          },
          "pan": { "type": "string", "description": "Номер карты (новая карта)" },
          "expireDate": { "type": "string", "description": "Срок действия (новая карта)" },
          "cardId": { "type": "string", "description": "ID сохранённой карты" },
          "cvv": { "type": "string", "description": "CVV (любой символ — фикция)" },
          "saveCard": { "type": "boolean", "description": "Сохранить новую карту", "default": true }
        },
        "required": ["transactionId", "method"]
      },
      "PayTransactionResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "description": "Статус запроса" },
          "reason": { "type": "string", "description": "Причина ошибки" },
          "transaction": {
            "description": "Оплаченная транзакция",
            "allOf": [{ "$ref": "#/components/schemas/Transaction" }]
          }
        },
        "required": ["success", "transaction"]
      },
      "PizzaCategory": { "type": "string", "enum": ["pizza", "breakfast", "wings", "milkshake"] },
      "PizzaSize": {
        "type": "string",
        "enum": ["small", "medium", "large"],
        "description": "Идентификатор размера продукта"
      },
      "PizzaItemSize": {
        "type": "object",
        "properties": {
          "type": {
            "description": "Идентификатор размера продукта",
            "example": "small",
            "allOf": [{ "$ref": "#/components/schemas/PizzaSize" }]
          },
          "price": { "type": "number", "description": "Цена для данного размера" },
          "volume": { "type": "number", "description": "Числовой объём/количество", "example": 0.4 }
        },
        "required": ["type", "price"]
      },
      "PizzaOptionType": {
        "type": "string",
        "enum": ["crust_thin", "crust_thick", "crust_cheese", "cream_with", "cream_without"],
        "description": "Идентификатор опции"
      },
      "PizzaOption": {
        "type": "object",
        "properties": {
          "type": {
            "description": "Идентификатор опции",
            "example": "crust_thin",
            "allOf": [{ "$ref": "#/components/schemas/PizzaOptionType" }]
          },
          "price": { "type": "number", "description": "Цена опции" }
        },
        "required": ["type", "price"]
      },
      "PizzaIngredientType": {
        "type": "string",
        "enum": [
          "pineapple",
          "mozzarella",
          "pepperoni",
          "green_pepper",
          "mushrooms",
          "basil",
          "cheddar",
          "parmesan",
          "feta",
          "ham",
          "pickle",
          "tomato",
          "bacon",
          "onion",
          "chile",
          "shrimp",
          "chicken_fillet",
          "meatballs"
        ],
        "description": "Идентификатор ингредиента"
      },
      "PizzaIngredient": {
        "type": "object",
        "properties": {
          "type": {
            "description": "Идентификатор ингредиента",
            "example": "pineapple",
            "allOf": [{ "$ref": "#/components/schemas/PizzaIngredientType" }]
          },
          "price": { "type": "number", "description": "Цена ингредиента" },
          "img": { "type": "string", "description": "Изображение ингредиента" }
        },
        "required": ["type", "price", "img"]
      },
      "PizzaProduct": {
        "type": "object",
        "properties": {
          "_id": { "type": "string", "description": "ID продукта" },
          "category": {
            "description": "Категория продукта",
            "example": "pizza",
            "allOf": [{ "$ref": "#/components/schemas/PizzaCategory" }]
          },
          "name": { "type": "string", "description": "Название", "example": "Двойной цыпленок" },
          "description": { "type": "string", "description": "Описание" },
          "img": { "type": "string", "description": "Изображение" },
          "sizes": {
            "description": "Доступные размеры",
            "type": "array",
            "items": { "$ref": "#/components/schemas/PizzaItemSize" }
          },
          "options": {
            "description": "Доступные доп-опции",
            "type": "array",
            "items": { "$ref": "#/components/schemas/PizzaOption" }
          },
          "ingredients": {
            "description": "Состав / доступные доп-ингредиенты",
            "type": "array",
            "items": { "$ref": "#/components/schemas/PizzaIngredient" }
          },
          "calories": { "type": "number", "description": "Калории" },
          "protein": { "type": "string", "description": "Белки" },
          "totalFat": { "type": "string", "description": "Жиры" },
          "carbohydrates": { "type": "string", "description": "Углеводы" },
          "sodium": { "type": "string", "description": "Натрий" },
          "allergens": {
            "description": "Аллергены",
            "type": "array",
            "items": { "type": "string" }
          },
          "isVegetarian": { "type": "boolean", "description": "Вегетарианский" },
          "isGlutenFree": { "type": "boolean", "description": "Без глютена" },
          "isNovelty": { "type": "boolean", "description": "Новинка" },
          "isHit": { "type": "boolean", "description": "Хит" }
        },
        "required": [
          "_id",
          "category",
          "name",
          "description",
          "img",
          "sizes",
          "calories",
          "protein",
          "totalFat",
          "carbohydrates",
          "sodium",
          "allergens",
          "isVegetarian",
          "isGlutenFree",
          "isNovelty",
          "isHit"
        ]
      },
      "GetPizzaCatalogResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "description": "Статус запроса" },
          "reason": { "type": "string", "description": "Причина ошибки" },
          "catalog": {
            "description": "Каталог продуктов",
            "type": "array",
            "items": { "$ref": "#/components/schemas/PizzaProduct" }
          }
        },
        "required": ["success", "catalog"]
      },
      "ObjectId": { "type": "object", "properties": {} },
      "PizzaOrderedItem": {
        "type": "object",
        "properties": {
          "_id": {
            "description": "Идентификатор продукта",
            "allOf": [{ "$ref": "#/components/schemas/ObjectId" }]
          },
          "category": {
            "description": "Категория продукта",
            "example": "pizza",
            "allOf": [{ "$ref": "#/components/schemas/PizzaCategory" }]
          },
          "quantity": {
            "type": "number",
            "description": "Количество одинаковых позиций",
            "example": 1,
            "default": 1
          },
          "size": {
            "description": "Размер",
            "example": "small",
            "allOf": [{ "$ref": "#/components/schemas/PizzaSize" }]
          },
          "option": {
            "description": "Выбранная доп-опция: корка, сливки и т.д.",
            "example": "crust_thin",
            "allOf": [{ "$ref": "#/components/schemas/PizzaOptionType" }]
          },
          "toppings": {
            "type": "array",
            "description": "Доп-ингредиенты",
            "items": { "$ref": "#/components/schemas/PizzaIngredientType" }
          }
        },
        "required": ["_id", "category", "quantity"]
      },
      "CalculatePizzaOrderDto": {
        "type": "object",
        "properties": {
          "items": {
            "description": "Позиции корзины",
            "type": "array",
            "items": { "$ref": "#/components/schemas/PizzaOrderedItem" }
          }
        },
        "required": ["items"]
      },
      "CalculatedItem": {
        "type": "object",
        "properties": {
          "productId": { "type": "string", "description": "ID продукта" },
          "name": { "type": "string", "description": "Название" },
          "quantity": { "type": "number", "description": "Количество" },
          "unitPrice": { "type": "number", "description": "Цена одной позиции" },
          "totalPrice": { "type": "number", "description": "Итого по позиции" }
        },
        "required": ["productId", "name", "quantity", "unitPrice", "totalPrice"]
      },
      "PizzaCommission": {
        "type": "object",
        "properties": {
          "amount": { "type": "number", "description": "Сумма комиссии", "example": 149 },
          "currency": { "type": "string", "description": "Валюта", "example": "RUB" }
        },
        "required": ["amount", "currency"]
      },
      "CalculateOrderResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "description": "Статус запроса" },
          "reason": { "type": "string", "description": "Причина ошибки" },
          "items": {
            "description": "Позиции с ценами",
            "type": "array",
            "items": { "$ref": "#/components/schemas/CalculatedItem" }
          },
          "itemsPrice": { "type": "number", "description": "Сумма позиций без доставки" },
          "commission": {
            "description": "Комиссия за доставку",
            "allOf": [{ "$ref": "#/components/schemas/PizzaCommission" }]
          },
          "totalPrice": { "type": "number", "description": "Итоговая сумма" }
        },
        "required": ["success", "items", "itemsPrice", "commission", "totalPrice"]
      },
      "CreatePizzaPaymentAddressDto": {
        "type": "object",
        "properties": {
          "street": { "type": "string", "description": "Улица", "example": "street" },
          "house": { "type": "string", "description": "Номер дома", "example": "house" },
          "apartment": {
            "type": "string",
            "description": "Номер квартиры",
            "example": "apartment"
          },
          "comment": { "type": "string", "description": "Комментарий", "example": "comment" }
        },
        "required": ["street", "house", "apartment"]
      },
      "CreatePizzaPaymentPersonDto": {
        "type": "object",
        "properties": {
          "phone": { "type": "string", "description": "Телефон", "example": "89990009999" }
        },
        "required": ["phone"]
      },
      "CreatePizzaPaymentDto": {
        "type": "object",
        "properties": {
          "receiverAddress": {
            "description": "Адрес доставки",
            "allOf": [{ "$ref": "#/components/schemas/CreatePizzaPaymentAddressDto" }]
          },
          "person": {
            "description": "Данные пользователя",
            "allOf": [{ "$ref": "#/components/schemas/CreatePizzaPaymentPersonDto" }]
          },
          "items": {
            "description": "Позиции корзины",
            "type": "array",
            "items": { "$ref": "#/components/schemas/PizzaOrderedItem" }
          }
        },
        "required": ["receiverAddress", "person", "items"]
      },
      "PizzaPerson": {
        "type": "object",
        "properties": {
          "firstname": { "type": "string", "description": "Имя", "example": "firstname" },
          "lastname": { "type": "string", "description": "Фамилия", "example": "lastname" },
          "middlename": { "type": "string", "description": "Отчество", "example": "middlename" },
          "phone": { "type": "string", "description": "Телефон", "example": "89990009999" }
        },
        "required": ["firstname", "lastname", "middlename", "phone"]
      },
      "PizzaAddress": {
        "type": "object",
        "properties": {
          "street": { "type": "string", "description": "Улица", "example": "street" },
          "house": { "type": "string", "description": "Номер дома", "example": "house" },
          "apartment": {
            "type": "string",
            "description": "Номер квартиры",
            "example": "apartment"
          },
          "comment": { "type": "string", "description": "Комментарий", "example": "comment" }
        },
        "required": ["street", "house", "apartment", "comment"]
      },
      "PizzaStatus": {
        "type": "string",
        "enum": [
          "awaiting_payment",
          "in_processing",
          "waiting_courier",
          "on_my_way",
          "success",
          "canceled"
        ],
        "description": "Статус заказа"
      },
      "PizzaOrder": {
        "type": "object",
        "properties": {
          "_id": { "type": "string", "description": "ID заказа" },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "description": "Дата создания заказа"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string",
            "description": "Дата обновления заказа"
          },
          "items": {
            "description": "Позиции заказа",
            "type": "array",
            "items": { "$ref": "#/components/schemas/PizzaOrderedItem" }
          },
          "itemsPrice": { "type": "number", "description": "Сумма позиций без доставки" },
          "commission": {
            "description": "Комиссия за доставку (0 — бесплатно)",
            "allOf": [{ "$ref": "#/components/schemas/PizzaCommission" }]
          },
          "totalPrice": { "type": "number", "description": "Итоговая сумма (позиции + доставка)" },
          "person": {
            "description": "Данные пользователя",
            "allOf": [{ "$ref": "#/components/schemas/PizzaPerson" }]
          },
          "receiverAddress": {
            "description": "Адрес доставки",
            "allOf": [{ "$ref": "#/components/schemas/PizzaAddress" }]
          },
          "status": {
            "description": "Статус заказа",
            "example": "awaiting_payment",
            "allOf": [{ "$ref": "#/components/schemas/PizzaStatus" }]
          },
          "cancellable": { "type": "boolean", "description": "Можно ли отменить заказ" },
          "transactionId": {
            "type": "string",
            "description": "ID связанной транзакции",
            "nullable": true
          }
        },
        "required": [
          "_id",
          "createdAt",
          "updatedAt",
          "items",
          "itemsPrice",
          "commission",
          "totalPrice",
          "person",
          "receiverAddress",
          "status",
          "cancellable",
          "transactionId"
        ]
      },
      "CreatePizzaPaymentResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "description": "Статус запроса" },
          "reason": { "type": "string", "description": "Причина ошибки" },
          "order": {
            "description": "Созданный заказ",
            "allOf": [{ "$ref": "#/components/schemas/PizzaOrder" }]
          }
        },
        "required": ["success", "order"]
      },
      "GetPizzaOrdersResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "description": "Статус запроса" },
          "reason": { "type": "string", "description": "Причина ошибки" },
          "orders": {
            "description": "Доставки",
            "type": "array",
            "items": { "$ref": "#/components/schemas/PizzaOrder" }
          }
        },
        "required": ["success", "orders"]
      },
      "GetPizzaOrderResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "description": "Статус запроса" },
          "reason": { "type": "string", "description": "Причина ошибки" },
          "order": {
            "description": "Доставки",
            "allOf": [{ "$ref": "#/components/schemas/PizzaOrder" }]
          }
        },
        "required": ["success", "order"]
      },
      "CancelPizzaOrderResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "description": "Статус запроса" },
          "reason": { "type": "string", "description": "Причина ошибки" },
          "order": {
            "description": "Отменённый заказ",
            "allOf": [{ "$ref": "#/components/schemas/PizzaOrder" }]
          }
        },
        "required": ["success", "order"]
      }
    }
  }
}
